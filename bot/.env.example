# 0 = paper trading (no real money), 1 = real orders
LIVE=0
START_BANKROLL=200

# --- NBA halftime strategy ---
# Trailing team's halftime deficit range (points)
MIN_DEF=10
MAX_DEF=19
# Only teams that were close / favourites before the game
EQUAL_ONLY=1
# Pre-game strength source: pm = Polymarket pre-game price, espn = ESPN model
EQUAL_SOURCE=pm
EQUAL_LO=0.40
EQUAL_HI=0.80
# Minimum edge after fees (probability points)
MIN_EDGE=0.03
# Conservativeness: fair probability = historical rate minus Z standard errors
Z=1.0
MAX_HANDICAP=15

# --- Risk ---
# Stake as a share of the current bankroll
STAKE_PCT=0.05
# Max $ per bet (0 = no cap)
MAX_STAKE=0
MAX_BETS_PER_DAY=4
MAX_DAILY_LOSS=30
# Fee model: rate * p * (1 - p) per share (conservative)
FEE_RATE=0.05

# Take-profit: sell when net profit (after fees) >= TP_PCT of the stake
TP_ENABLED=1
TP_PCT=0.25

# --- Telegram alerts (optional) ---
TG_BOT_TOKEN=
TG_CHAT_ID=

# --- Live trading only (LIVE=1) ---
# PRIVATE_KEY: key of the wallet used to log in to Polymarket
# FUNDER: your Polymarket wallet address (shown in profile), holds pUSD
# SIGNATURE_TYPE: 1 = email / Magic login, 2 = browser wallet (MetaMask etc.)
PRIVATE_KEY=
FUNDER=
SIGNATURE_TYPE=1

# --- Tennis: pre-match underdog wins set 1 -> buy their match moneyline ---
TENNIS_ENABLED=1
# "Underdog" = pre-match price below this
TENNIS_DOG_MAX=0.40
# Only enter within this price range
TENNIS_MIN_ASK=0.30
TENNIS_MAX_ASK=0.85
TENNIS_MAX_PER_DAY=6
# Poll interval (seconds) and max minutes after set 1 to still enter
TENNIS_POLL_SEC=15
TENNIS_MAX_DELAY_MIN=4
# 1 = big tournaments only (Slams, Masters/1000), as in the backtest
TENNIS_BIG_ONLY=1
# Also include 500-level events (reported separately)
TENNIS_INCLUDE_500=1
